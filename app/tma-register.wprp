<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="CpuFreq diagnostic">
  <Profiles>
    <SystemCollector Id="Collector" Name="CpuFreqTmaRegistration">
      <BufferSize Value="128"/><Buffers Value="128"/>
    </SystemCollector>
    <SystemProvider Id="Provider">
      <Keywords><Keyword Value="CSwitch"/></Keywords>
    </SystemProvider>
    <MicroArchitecturalConfig Id="TmaConfig" Base="">
      <ProfileSources Architecture="INTEL" Family="6" Model="151" Description="Alder Lake P-core diagnostic">
        <ProfileSource Name="CFMTmaV1Slots" Event="0xA4" Unit="0x01" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1Retired" Event="0xC2" Unit="0x02" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1BadSpec" Event="0xA4" Unit="0x04" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1Memory" Event="0xA4" Unit="0x10" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1Backend" Event="0xA4" Unit="0x02" Interval="0x02000003" Persist="false"/>
      </ProfileSources>
      <ProfileSources Architecture="INTEL" Family="6" Model="154" Description="Alder Lake P-core diagnostic">
        <ProfileSource Name="CFMTmaV1Slots" Event="0xA4" Unit="0x01" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1Retired" Event="0xC2" Unit="0x02" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1BadSpec" Event="0xA4" Unit="0x04" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1Memory" Event="0xA4" Unit="0x10" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CFMTmaV1Backend" Event="0xA4" Unit="0x02" Interval="0x02000003" Persist="false"/>
      </ProfileSources>
    </MicroArchitecturalConfig>
    <HardwareCounter Id="Counters" Strict="true">
      <MicroArchitecturalConfigId Value="TmaConfig"/><Counters><Counter Value="CFMTmaV1Slots"/></Counters><Events><Event Value="CSwitch"/></Events>
      
    </HardwareCounter>
    <Profile Id="TmaRegister.Verbose.Memory" Name="TmaRegister" Description="Short PMU diagnostic" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="Collector"><SystemProviderId Value="Provider"/><HardwareCounterId Value="Counters"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>






