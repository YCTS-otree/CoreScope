#include <winres.h>
#include "../shared/version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CORESCOPE_VERSION_MAJOR,CORESCOPE_VERSION_MINOR,CORESCOPE_VERSION_PATCH,0
 PRODUCTVERSION CORESCOPE_VERSION_MAJOR,CORESCOPE_VERSION_MINOR,CORESCOPE_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "YCTS-otree"
            VALUE "FileDescription", "CoreScope CPU and memory performance monitor"
            VALUE "FileVersion", CORESCOPE_VERSION_STRING
            VALUE "InternalName", "CoreScope"
            VALUE "LegalCopyright", "Copyright (C) 2026 YCTS-otree; GPL-3.0-only"
            VALUE "OriginalFilename", "CoreScope.exe"
            VALUE "ProductName", "CoreScope"
            VALUE "ProductVersion", CORESCOPE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
