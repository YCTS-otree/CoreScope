<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="CpuFreq diagnostic">
  <Profiles>
    <SystemCollector Id="Collector" Name="CpuFreqPmuDiagnostic">
      <BufferSize Value="128"/><Buffers Value="128"/>
    </SystemCollector>
    <SystemProvider Id="Provider">
      <Keywords><Keyword Value="ProcessThread"/><Keyword Value="CSwitch"/></Keywords>
    </SystemProvider>
    <MicroArchitecturalConfig Id="TmaConfig" Base="">
      <ProfileSources Architecture="INTEL" Family="6" Model="151" Description="Alder Lake P-core diagnostic">
        <ProfileSource Name="CpuFreqTmaSlots" Event="0xA4" Unit="0x01" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CpuFreqTmaRetired" Event="0xC2" Unit="0x02" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CpuFreqTma0BadSpec" Event="0xA4" Unit="0x04" Interval="0x02000003" Persist="false"/>
        <ProfileSource Name="CpuFreqTmaBackend" Event="0xA4" Unit="0x02" Interval="0x02000003" Persist="false"/>
      </ProfileSources>
    </MicroArchitecturalConfig>
    <HardwareCounter Id="Counters" Strict="true">
      <MicroArchitecturalConfigId Value="TmaConfig"/><Counters>
        <Counter Value="CpuFreqTmaSlots"/>
        <Counter Value="CpuFreqTmaRetired"/>
        <Counter Value="CpuFreqTma0BadSpec"/><Counter Value="CpuFreqTmaBackend"/>
      </Counters>
      <Events><Event Value="CSwitch"/></Events>
    </HardwareCounter>
    <Profile Id="Pmu.Verbose.File" Name="Pmu" Description="Short PMU diagnostic" LoggingMode="File" DetailLevel="Verbose">
      <Collectors><SystemCollectorId Value="Collector"><SystemProviderId Value="Provider"/><HardwareCounterId Value="Counters"/></SystemCollectorId></Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>



